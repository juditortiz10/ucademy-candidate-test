# ==============================================
# Candidate Test - Environment Variables
# ==============================================
# Copia este archivo como .env y configura los valores

# MongoDB
MONGODB_URI=mongodb://localhost:27017/candidate-test

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# Modelo de chat. gpt-5-mini es un modelo de razonamiento: no admite
# `max_tokens` ni un `temperature` distinto del valor por defecto.
# Ver DECISIONS.md, decision 1.
OPENAI_CHAT_MODEL=gpt-5-mini

# Modelo de embeddings (1536 dimensiones con 3-small, 3072 con 3-large).
# Cambiarlo obliga a reindexar: los vectores de distinta dimension se
# descartan en la busqueda.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Esfuerzo de razonamiento: low | medium | high.
# `low` reduce latencia y coste sin perder calidad en este caso de uso.
OPENAI_REASONING_EFFORT=low

# Server
PORT=3333
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Solo para el script scripts/index-courses.ts
API_URL=http://localhost:3333/api
